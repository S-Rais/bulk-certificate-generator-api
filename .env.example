# All settings are optional; defaults work out of the box.
CERTGEN_DATABASE_URL=sqlite:///./certgen.db
CERTGEN_STORAGE_DIR=./storage
CERTGEN_MAX_RECIPIENTS_PER_JOB=5000
CERTGEN_WORKER_THREADS=4
# Leave empty to disable auth. If set, clients must send  X-API-Key: <value>
CERTGEN_API_KEY=
CERTGEN_PUBLIC_BASE_URL=http://localhost:8000
